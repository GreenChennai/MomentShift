# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.venv/
venv/

# ---- Packaging / PyInstaller ----
build/
dist/
dist_build/
dist_build_*/
build_work_*/
# Stray per-version build dirs must never be committed (e.g. dist_v021/022 were
# accidentally pushed in the past). Build output now lives OUTSIDE the repo at
# ../构建/ (see build notes), so ignore any that appear here.
dist_v0*/
release/
*.manifest
*.spec.bak

# ---- Downloaded ffmpeg assets (fetched by CI / tools) ----
tools/ffmpeg_bin/
dist_assets/

# ---- Bundled external tools (downloaded in-app, not committed) ----
tools/*.exe

# ---- Upscale / interpolation engines (v0.7.5) ----
# Users drop each engine into tools/<engine-id>/ manually; never commit them.
tools/realesrgan/
tools/realesrgan-ncnn-vulkan/
tools/waifu2x-ncnn-vulkan/
tools/waifu2x-caffe/
tools/waifu2x-converter/
tools/srmd-ncnn-vulkan/
tools/srmd-cuda/
tools/realsr-ncnn-vulkan/
tools/realcugan-ncnn-vulkan/
tools/anime4kcpp/
tools/rtx-super-resolution/
tools/rife-ncnn-vulkan/
tools/cain-ncnn-vulkan/
tools/dain-ncnn-vulkan/
tools/ifrnet-ncnn-vulkan/

# ---- Editors / OS ----
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store

# ---- Local config (user settings are stored in OS config dir) ----
config.json

# ---- Runtime logs (written next to the executable) ----
logs/
dist_v020/
